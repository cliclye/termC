{
  "name": "termc",
  "productName": "TermC",
  "version": "1.1.0",
  "description": "A free terminal for AI-assisted development: splits, workspaces, Git, files, dev server preview, plugins and MCP.",
  "main": "dist/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs --watch & electron .",
    "postinstall": "electron-builder install-app-deps",
    "mcp": "node mcp/termc-mcp.js",
    "dist": "node build.mjs && electron-builder --mac",
    "icon": "python3 build/make-icon.py"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "author": "TermC",
  "build": {
    "appId": "dev.termc.app",
    "productName": "TermC",
    "copyright": "Free and open source",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "resources/**/*",
      "mcp/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "resources/**",
      "mcp/**"
    ],
    "afterPack": "build/after-pack.js",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "TermC runs commands you start in its terminals and controls Spotify playback from its music player."
      }
    },
    "dmg": {
      "title": "TermC",
      "iconSize": 96,
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cliclye/termC.git"
  }
}
